import os

# --- Configuration ---
base_mod_dir = "/home/ariel2/Projects/optimal_mod_runs"
base_mod_fol = "sm_"  # Base folder name
base_mod_id = "sm_"    # Base model ID
num_models = 5  # Change this to the total number of models you want to run
nprocs = 1  # Adjust this to your system's needs
imod_wq_bin = "/home/ariel2/imodwq/seawat/bin/seawat-svn390"
intel_oneapi_env = "/opt/intel/oneapi/setvars.sh"
output_base_dir = os.path.join(base_mod_dir, "outputs")

# --- Function to generate a single shell script ---
def create_shell_script(model_num):
    mod_fol = f"{base_mod_fol}{model_num}"
    mod_id = f"{base_mod_id}{model_num}"
    mod_dir = os.path.join(base_mod_dir, mod_fol)
    namfile = os.path.join(mod_dir, f"{mod_id}.nam_swt")
    output_dir = os.path.join(output_base_dir, mod_id)
    logfile = os.path.join(output_dir, f"run_$(date +%Y%m%d_%H%M%S).log")
    script_name = f"run_{mod_id}.sh"
    script_path = os.path.join(base_mod_dir, script_name)

    # Create output directory if it doesn't exist
    os.makedirs(output_dir, exist_ok=True)

    with open(script_path, "w") as f:
        f.write("#!/bin/bash\n\n")
        f.write(f"# Model ID: {mod_id}\n")
        f.write(f"# Folder: {mod_fol}\n\n")

        f.write(f"MOD_DIR=\"{base_mod_dir}\"\n")
        f.write(f"MOD_FOL=\"{mod_fol}\"\n")
        f.write(f"MOD_ID=\"{mod_id}\"\n")
        f.write(f"NPROCS={nprocs}\n")
        f.write(f"NAMFILE=\"${{MOD_DIR}}/${{MOD_FOL}}/${{MOD_ID}}.nam_swt\"\n\n")

        f.write(f"OUTPUT_DIR=\"{output_base_dir}/${{MOD_ID}}\"\n")
        f.write("mkdir -p \"$OUTPUT_DIR\"\n\n")

        f.write(f"LOGFILE=\"${{OUTPUT_DIR}}/run_$(date +%Y%m%d_%H%M%S).log\"\n")
        f.write(f"IMOD_WQ_BIN=\"{imod_wq_bin}\"\n")
        f.write(f"INTEL_ONEAPI_ENV=\"{intel_oneapi_env}\"\n\n")

        f.write("# --------- ENVIRONMENT SETUP ---------\n")
        f.write("if [ -f \"$INTEL_ONEAPI_ENV\" ]; then\n")
        f.write("    echo \"Sourcing Intel OneAPI environment...\"\n")
        f.write("    source \"$INTEL_ONEAPI_ENV\" > /dev/null 2>&1\n")
        f.write("fi\n\n")

        f.write("source /opt/intel/oneapi/setvars.sh > /dev/null 2>&1\n")
        f.write("export I_MPI_PIN=1\n")
        f.write("export I_MPI_FABRICS=shm:tcp\n")
        f.write("export I_MPI_DEBUG=5\n\n")

        f.write("# --------- RUN THE MODEL ------------- \n")
        f.write(f"echo \"Starting iMOD-WQ for {mod_id} with ${{NPROCS}} MPI processes...\"\n")
        f.write(f"cd \"${{MOD_DIR}}/${{MOD_FOL}}\"\n")
        f.write(f"mpiexec -n \"${{NPROCS}}\" \"${{IMOD_WQ_BIN}}\" \"${{NAMFILE}}\" > \"${{LOGFILE}}\" 2>&1\n\n")
        f.write("EXIT_CODE=$?\n")
        f.write("if [ $EXIT_CODE -eq 0 ]; then\n")
        f.write(f"    echo \"✅ Simulation for {mod_id} completed successfully.\"\n")
        f.write("else\n")
        f.write(f"    echo \"❌ Simulation for {mod_id} failed with exit code $EXIT_CODE.\"\n")
        f.write("fi\n\n")

        # Optional: Remove the gedit line for HPC runs
        # f.write("gedit \"$LOGFILE\" &")

    # Make the script executable
    os.chmod(script_path, 0o755)
    print(f"Generated shell script: {script_path}")

# --- Main loop to generate scripts for each model ---
for i in range(1, num_models + 1):
    create_shell_script(i)

print("\nShell scripts generated successfully. You can now submit them to your HPC.")
